# ═══ Manasyn v2 Environment Variables ═══
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file. NEVER put these in frontend code.

# ── Server ──
MANASYN_PORT=4567
NODE_ENV=development

# ── Supabase (Auth + Database) ──
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SERVICE_ROLE_KEY — NEVER expose this in frontend. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Session ──
SESSION_SECRET=generate-a-long-random-string-here

# ── Database (SQLite for local dev, Supabase for production) ──
DB_PATH=./db/manasyn.db

# ── Frontend (Cloudflare Pages) ──
# These are safe to expose — anon key only, no service role.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here