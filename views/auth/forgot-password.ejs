<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">Manasyn</div>
    <h1 class="auth-title">Reset password.</h1>
    <p class="auth-sub">Enter your email and we'll send a reset link.</p>
    <% if (flash) { %><div class="flash flash--<%= flash.type %> mb-6"><%= flash.message %></div><% } %>
    <form action="/auth/forgot-password" method="POST">
      <div class="input-group">
        <label class="input-label">Email</label>
        <input class="input-field" type="email" name="email" placeholder="you@example.com" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">Send reset link</button>
    </form>
    <div class="auth-footer"><a href="/auth/login">Back to login</a></div>
  </div>
</div>
<%- include('../partials/footer') %>