<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">Manasyn</div>
    <h1 class="auth-title">Welcome back.</h1>
    <p class="auth-sub">Continue your journey.</p>

    <% if (flash) { %>
      <div class="flash flash--<%= flash.type %> mb-6"><%= flash.message %></div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="input-group">
        <label class="input-label">Email</label>
        <input class="input-field" type="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="input-group">
        <label class="input-label">Password</label>
        <input class="input-field" type="password" name="password" placeholder="••••••••" required>
      </div>
      <div style="text-align:right; margin-bottom: var(--s-5);">
        <a href="/auth/forgot-password" style="font-size:13px;">Forgot password?</a>
      </div>
      <button type="submit" class="btn btn--primary btn--block">Continue</button>
    </form>

    <div class="auth-divider">or</div>

    <button class="auth-alt-btn" onclick="alert('Google login would be configured here.')">Continue with Google</button>
    <button class="auth-alt-btn" onclick="alert('Apple login would be configured here.')">Continue with Apple</button>

    <div class="auth-footer">
      Don't have an account? <a href="/auth/signup">Create account</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>