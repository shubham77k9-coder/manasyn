<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="container" style="padding-top: var(--s-12);">
  <div class="section-label text-center">How it works</div>
  <h1 class="italic-serif text-center mb-4">Support · Reflect · Grow</h1>
  <p class="text-center text-2 mb-8" style="max-width:600px;margin:0 auto var(--s-8);">Three steps that form the central UX philosophy of Manasyn.</p>
  <div class="how-steps">
    <div class="card how-step">
      <div class="how-step__num">01 — Support</div>
      <h3 class="how-step__title">Talk openly.</h3>
      <p class="text-2">A private space to express what's on your mind. No judgment, no pressure.</p>
    </div>
    <div class="card how-step">
      <div class="how-step__num">02 — Reflect</div>
      <h3 class="how-step__title">Understand what you're experiencing.</h3>
      <p class="text-2">Explore thoughts, emotions and patterns with guided reflections.</p>
    </div>
    <div class="card how-step">
      <div class="how-step__num">03 — Grow</div>
      <h3 class="how-step__title">Turn insight into action.</h3>
      <p class="text-2">Build practical next steps and healthier habits through self-work.</p>
    </div>
  </div>
  <div class="how-flow">
    <span>Support</span><span style="color:var(--brand-3);">→</span>
    <span>Reflect</span><span style="color:var(--brand-3);">→</span>
    <span>Grow</span>
  </div>
  <div class="text-center mt-8">
    <a href="/auth/signup" class="btn btn--primary btn--lg">Start Your Journey</a>
  </div>
</div>
<%- include('../partials/footer') %>