  <a href="/student/osce" class="sidebar__item <%= path.startsWith('/student/osce') ? 'active' : '' %>">OSCE</a>
  <a href="/student/flashcards" class="sidebar__item <%= path.startsWith('/student/flashcards') ? 'active' : '' %>">Flashcards</a>
  <a href="/student/research" class="sidebar__item <%= path.startsWith('/student/research') ? 'active' : '' %>">Research</a>
  <% } %>
  <div class="sidebar__divider"></div>
  <a href="/app/settings" class="sidebar__item <%= path.startsWith('/app/settings') ? 'active' : '' %>">Settings</a>
</aside>