<aside class="sidebar">
  <div class="sidebar__brand">Manasyn</div>
  <div class="sidebar__label">Personal</div>
  <a href="/app/dashboard" class="sidebar__item <%= path.startsWith('/app/dashboard') ? 'active' : '' %>">Home</a>
  <a href="/app/talk" class="sidebar__item <%= path.startsWith('/app/talk') ? 'active' : '' %>">Talk</a>
  <a href="/app/reflect" class="sidebar__item <%= path.startsWith('/app/reflect') ? 'active' : '' %>">Reflect</a>
  <a href="/app/self-work" class="sidebar__item <%= path.startsWith('/app/self-work') ? 'active' : '' %>">Self-work</a>
  <a href="/app/progress" class="sidebar__item <%= path.startsWith('/app/progress') ? 'active' : '' %>">Progress</a>
  <a href="/app/journal" class="sidebar__item <%= path.startsWith('/app/journal') ? 'active' : '' %>">Journal</a>
