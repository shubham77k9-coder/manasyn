  <a href="/student/dashboard" class="sidebar__item <%= path.startsWith('/student/dashboard') ? 'active' : '' %>">Student Home</a>
  <a href="/student/case-coach" class="sidebar__item <%= path.startsWith('/student/case-coach') ? 'active' : '' %>">Case Coach</a>
