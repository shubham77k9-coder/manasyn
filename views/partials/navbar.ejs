<nav class="navbar">
  <div class="navbar__inner">
    <a href="/" class="navbar__brand" style="text-decoration:none;">Manasyn</a>
    <% if (typeof showNavLinks === 'undefined' || showNavLinks) { %>
    <div class="navbar__links">
      <a href="/how-it-works">How it works</a>
      <a href="/for-you">For You</a>
      <a href="/for-students">For Students</a>
      <a href="/safety">Safety</a>
      <a href="/about">About</a>
    </div>
    <% } %>
    <div class="navbar__actions">
      <button class="navbar__theme" onclick="toggleTheme()" aria-label="Toggle theme">
        <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <% if (user) { %>
        <a href="/app/dashboard" class="btn btn--tertiary btn--sm">Dashboard</a>
        <form method="POST" action="/auth/logout" style="display:inline">
          <button type="submit" class="btn btn--secondary btn--sm">Log out</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn btn--tertiary btn--sm">Log in</a>
        <a href="/auth/signup" class="btn btn--primary btn--sm">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>