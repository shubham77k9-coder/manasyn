<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <% if (flash) { %><div class="flash flash--<%= flash.type %> mb-6"><%= flash.message %></div><% } %>
    <div class="section-label">Journal</div>
    <h1 class="italic-serif mb-6" style="font-size:28px;">Write what's on your mind.</h1>

    <div class="card mb-8">
      <div class="card-label">New entry</div>
      <form action="/app/journal" method="POST">
        <div class="input-group"><label class="input-label">Title (optional)</label><input class="input-field" type="text" name="title" placeholder="Give your entry a title..."></div>
        <div class="input-group"><label class="input-label">Mood</label>
          <select class="input-field" name="mood">
            <option value="">How are you feeling?</option>
            <option value="calm">Calm</option><option value="happy">Happy</option><option value="neutral">Neutral</option>
            <option value="anxious">Anxious</option><option value="sad">Sad</option><option value="overwhelmed">Overwhelmed</option><option value="angry">Angry</option>
          </select>
        </div>
        <div class="input-group"><label class="input-label">Entry</label><textarea class="input-field" name="content" rows="6" placeholder="Write freely..." required></textarea></div>
        <button type="submit" class="btn btn--primary">Save entry</button>
      </form>
    </div>

    <% if (entries.length === 0) { %>
      <div class="empty-state card">
        <div class="empty-state__title">No journal entries yet</div>
        <div class="empty-state__desc">Your entries will appear here once you start writing.</div>
      </div>
    <% } else { %>
      <h3 class="mb-4">Past entries</h3>
      <% entries.forEach(e => { %>
        <div class="card mb-4">
          <div class="flex-between mb-2">
            <div class="card-label"><%= new Date(e.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
            <% if (e.mood) { %><span class="badge badge--brand"><%= e.mood %></span><% } %>
          </div>
          <% if (e.title) { %><h4 style="margin-bottom:4px;"><%= e.title %></h4><% } %>
          <p class="text-2" style="font-size:14px;"><%- e.content.replace(/\n/g,'<br>') %></p>
          <form method="POST" action="/app/journal/<%= e.id %>/delete" style="margin-top:12px;">
            <button type="submit" class="btn btn--ghost btn--sm">Delete</button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>