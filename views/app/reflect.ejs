<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <% if (flash) { %><div class="flash flash--<%= flash.type %> mb-6"><%= flash.message %></div><% } %>
    <div class="section-label">Reflect</div>
    <h1 class="italic-serif mb-2" style="font-size:28px;">Your reflections</h1>
    <p class="text-2 mb-8">Understand what you're experiencing.</p>

    <div class="card mb-8">
      <div class="card-label">New reflection</div>
      <form action="/app/reflect" method="POST">
        <div class="grid-2">
          <div class="input-group"><label class="input-label">Emotion</label><input class="input-field" type="text" name="emotion" placeholder="What are you feeling?"></div>
          <div class="input-group"><label class="input-label">Possible trigger</label><input class="input-field" type="text" name="trigger" placeholder="What might have triggered this?"></div>
        </div>
        <div class="input-group"><label class="input-label">Pattern</label><textarea class="input-field" name="pattern" placeholder="What pattern do you notice?"></textarea></div>
        <div class="input-group"><label class="input-label">What might help?</label><textarea class="input-field" name="insight" placeholder="One small step that could help..."></textarea></div>
        <button type="submit" class="btn btn--primary">Save reflection</button>
      </form>
    </div>

    <% if (reflections.length === 0) { %>
      <div class="empty-state card">
        <div class="empty-state__title">No reflections yet</div>
        <div class="empty-state__desc">Your first reflection will appear here after you add one.</div>
      </div>
    <% } else { %>
      <h3 class="mb-4">Past reflections</h3>
      <% reflections.forEach(r => { %>
        <div class="card mb-4">
          <div class="card-label"><%= new Date(r.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
          <% if (r.emotion) { %><div class="reflection-row"><div class="reflection-row__label">Emotion</div><div class="reflection-row__value"><%= r.emotion %></div></div><% } %>
          <% if (r.trigger) { %><div class="reflection-row"><div class="reflection-row__label">Trigger</div><div class="reflection-row__value"><%= r.trigger %></div></div><% } %>
          <% if (r.pattern) { %><div class="reflection-row"><div class="reflection-row__label">Pattern</div><div class="reflection-row__value"><%= r.pattern %></div></div><% } %>
          <% if (r.insight) { %>
            <div class="reflection-insight">
              <div class="reflection-insight__label">What might help</div>
              <div><%= r.insight %></div>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>