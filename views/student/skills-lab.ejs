<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <div class="section-label">Skills Lab</div>
    <h1 class="italic-serif mb-2" style="font-size:28px;">Build counselling skills</h1>
    <p class="text-2 mb-8">Interactive scenarios to practice core therapeutic skills.</p>
    <div class="dash-actions">
      <% scenarios.forEach(s => { %>
        <a href="/student/skills-lab/<%= s.id %>" class="card action-card card--accent">
          <div class="action-card__title"><%= s.skill_name %></div>
          <div class="action-card__desc">"<%= s.scenario_text.substring(0, 50) %>..."</div>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>