<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <div class="section-label">OSCE Viva</div>
    <h1 class="italic-serif mb-2" style="font-size:28px;">Prepare for clinical viva</h1>
    <p class="text-2 mb-8">Practice answering clinical-style questions with structured feedback.</p>
    <div class="dash-actions">
      <% questions.forEach(q => { %>
        <a href="/student/osce/<%= q.id %>" class="card action-card card--accent">
          <div class="card-label"><%= (q.category || '').toUpperCase() %></div>
          <div class="action-card__title">Question <%= q.id %></div>
          <div class="action-card__desc"><%= q.scenario.substring(0, 60) %>...</div>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>