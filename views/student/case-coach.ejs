<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <div class="section-label">Case Coach</div>
    <h1 class="italic-serif mb-2" style="font-size:28px;">Practice realistic cases</h1>
    <p class="text-2 mb-8">Work through clinical scenarios with adaptive AI feedback.</p>
    <div class="dash-actions">
      <% cases.forEach(c => { %>
        <a href="/student/case-coach/<%= c.id %>" class="card action-card card--accent">
          <div class="card-label"><%= c.difficulty.toUpperCase() %></div>
          <div class="action-card__title"><%= c.title %></div>
          <div class="action-card__desc"><%= c.client_profile %></div>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>