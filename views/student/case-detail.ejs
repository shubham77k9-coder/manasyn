<%- include('../partials/head', {theme}) %>
<%- include('../partials/navbar') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <div class="flex-between mb-6">
      <div><div class="section-label"><%= caseData.difficulty.toUpperCase() %></div><h1 class="italic-serif" style="font-size:28px;"><%= caseData.title %></h1></div>
      <span class="badge badge--premium">Case <%= caseData.id %></span>
    </div>
    <div class="card mb-6">
      <div class="card-label">Client profile</div>
      <p style="font-size:15px; margin-bottom:16px;"><%= caseData.client_profile %></p>
      <div class="card-label">Presenting concern</div>
      <p style="font-size:15px;"><%= caseData.presenting_concern %></p>
    </div>
    <h3 class="italic-serif mb-4" style="font-size:20px;">What would you explore first?</h3>
    <div class="grid-2 mb-6">
      <button class="card action-card card--accent" onclick="respondToCase('ask')"><div class="action-card__title">Ask a question</div><div class="action-card__desc">Gather more information</div></button>
      <button class="card action-card card--accent" onclick="respondToCase('history')"><div class="action-card__title">Review history</div><div class="action-card__desc">Background and context</div></button>
      <button class="card action-card card--accent" onclick="respondToCase('differential')"><div class="action-card__title">Consider differential</div><div class="action-card__desc">Explore possible conditions</div></button>
      <button class="card action-card card--accent" onclick="respondToCase('formulate')"><div class="action-card__title">Formulate case</div><div class="action-card__desc">Build a clinical formulation</div></button>
    </div>
    <div id="feedback" class="hidden card card--success mb-6">
      <div class="card-label" style="color:var(--success);">AI Feedback</div>
      <p id="feedbackText" style="font-size:14px;"></p>
    </div>
    <% if (responses.length > 0) { %>
      <h3 class="mb-4">Your previous responses</h3>
      <% responses.forEach(r => { %>
        <div class="card mb-4">
          <div class="card-label"><%= new Date(r.created_at).toLocaleDateString('en-IN') %> · <%= r.action_type %></div>
          <p style="font-size:14px; color:var(--text-2);"><%= r.feedback %></p>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
<script>
async function respondToCase(action) {
  const res = await fetch('/student/case-coach/<%= caseData.id %>/respond', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ action_type: action, response_text: action })
  });
  const data = await res.json();
  document.getElementById('feedbackText').textContent = data.feedback;
  document.getElementById('feedback').classList.remove('hidden');
}
</script>
<%- include('../partials/mobile-nav') %>
<%- include('../partials/footer') %>